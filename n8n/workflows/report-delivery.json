{
  "name": "ArkaLedger Report Delivery",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 1 * *" }] } },
      "name": "Monthly Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.ARKALEDGER_URL}}/api/n8n/report-packages/{{$json.package_id}}/deliver"
      },
      "name": "Deliver Report",
      "type": "n8n-nodes-base.httpRequest",
      "position": [500, 300]
    }
  ],
  "connections": {
    "Monthly Schedule": { "main": [[{ "node": "Deliver Report", "type": "main", "index": 0 }]] }
  }
}
