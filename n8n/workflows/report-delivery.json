{
  "name": "ArkaLedger Report Delivery",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 8 5 * *" }]
        }
      },
      "name": "Monthly 5th 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.ARKALEDGER_BASE_URL}}/api/n8n/report-packages/{{$json.package_id}}/deliver",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "channel", "value": "email" }
          ]
        }
      },
      "name": "Deliver Approved Package",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Monthly 5th 08:00": {
      "main": [[{ "node": "Deliver Approved Package", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "arkaledger" }]
}
